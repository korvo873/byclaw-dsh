# Shared ByClaw identity. Required when byclaw-integration is enabled unless
# config.userCode supplies it directly.
USER_CODE=replace-with-byclaw-user-code

# Optional fixed token for the DSH Web root exchange; inject at runtime in containers.
# BYCLAW_DSH_WEB_AUTH_TOKEN=replace-with-web-launch-token

# Redis standalone connection used by @byclaw/by-framework.
REDIS_MODE=standalone
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-redis-password
REDIS_DATABASE=0

# Redis Cluster alternative. When enabled, comment out the standalone values
# above, set REDIS_MODE=cluster, and provide every seed as host:port.
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=redis-1.example.com:6379,redis-2.example.com:6379
# REDIS_KEY_SCHEMA_VERSION=v2

# Dynamic ByClaw model routing is enabled by default. Set this to false only
# when byclaw-dsh.config provides both provider and model.
BYCLAW_REDIS_MODEL_ENABLED=true

# Required by Redis dynamic-model mode. Supply the deployment's SM4 key as
# hexadecimal text; never commit the real value.
BAIYING_AIMODEL_AUTH_TOKEN_SM4_KEY_HEX=replace-with-sm4-key-hex

# Optional dynamic-model idle timeout in seconds. The runtime default is 600.
BYCLAW_LLM_IDLE_TIME=600
